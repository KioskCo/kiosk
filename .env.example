# ── Expo / React Native ───────────────────────────────────────────────────────
# Set to your API server domain (no https://, no trailing slash)
# In development this is your Replit dev domain e.g. abc123.replit.dev
# In production it is your server domain e.g. api.kiosk.store
EXPO_PUBLIC_DOMAIN=https://api.keeosk.store

# ── Sentry (crash reporting — optional) ──────────────────────────────────────
# sentry.io → Create Project → React Native → get DSN from Project Settings
# Leave blank in development; only crashes in production builds are sent.
EXPO_PUBLIC_SENTRY_DSN=https://270ff938fcd528fe25fa77117b327943@o4511858919407616.ingest.de.sentry.io/4511858946998352
